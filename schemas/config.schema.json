{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "DealBot config",
  "type": "object",
  "required": ["version", "schedule", "categories", "rss_feeds", "search_hints", "quiet_hours", "min_days_left", "feed_limit", "seen_ttl_days"],
  "additionalProperties": false,
  "properties": {
    "version": { "enum": [1] },
    "schedule": {
      "type": "object",
      "required": ["times", "timezone"],
      "additionalProperties": false,
      "properties": {
        "times": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hm" } },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "enabled", "keywords", "exclude", "sources", "priority"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "enabled": { "type": "boolean" },
          "keywords": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(search|[a-z0-9_]+(:[a-z0-9_-]+)?)$" } },
          "min_discount_pct": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
          "max_price_krw": { "type": ["integer", "null"], "minimum": 0 },
          "priority": { "enum": ["instant", "daily", "weekly"] }
        }
      }
    },
    "rss_feeds": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^https?://" }
    },
    "search_hints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "quiet_hours": {
      "type": ["object", "null"],
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": { "start": { "$ref": "#/$defs/hm" }, "end": { "$ref": "#/$defs/hm" } }
    },
    "min_days_left": { "type": "integer", "minimum": 0, "maximum": 365 },
    "feed_limit": { "type": "integer", "minimum": 10, "maximum": 5000 },
    "seen_ttl_days": { "type": "integer", "minimum": 1, "maximum": 365 }
  },
  "$defs": {
    "hm": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
  }
}
