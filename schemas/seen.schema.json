{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seen.schema.json",
  "title": "DealBot dedupe keys -> date first seen",
  "type": "object",
  "required": ["keys"],
  "additionalProperties": false,
  "properties": {
    "keys": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
    }
  }
}
